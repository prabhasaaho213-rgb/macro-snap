rules_version = '2';
// MacroSnap Firestore security rules
//
// Model:
//   - Only authenticated users can touch data.
//   - Users can only read/write their OWN documents (keyed by Firebase UID).
//   - Money / entitlement records (subscriptions, payments) are
//     SERVER-WRITE-ONLY — only the backend's Admin SDK (which bypasses these
//     rules) may write them; clients may read only their own.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore → Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }    // Admin/owner entitlement comes from the `admin` CUSTOM CLAIM, set by the
    // backend's Admin SDK. It used to compare the token's email against a
    // hardcoded address, which kept a personal address in the rules file and
    // made the privilege depend on an email string rather than on a claim only
    // the server can mint.
    function hasPro(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      return request.auth.token.admin == true
        || (exists(userPath) && (
          get(userPath).data.subscribed == true
          || (get(userPath).data.pro_until_at is timestamp
            && get(userPath).data.pro_until_at > request.time)
          || (get(userPath).data.trial_ends_at is timestamp
            && get(userPath).data.trial_ends_at > request.time)
        ));
    }

    // ─── users/{uid} — profile, subscription flag, scan counters ────────
    // READ-ONLY for clients. The app only ever reads this document; every
    // field that matters is an entitlement (`subscribed`, `trial_started_at`,
    // `scanCount`/`scanDay`, `referralCode`) and is written by the backend's
    // Admin SDK, which bypasses these rules. A client-side write is denied
    // outright, so nobody can grant themselves Pro or reset their own scan
    // counter (`subscribed: true` on your own doc is rejected).
    match /users/{uid} {
      allow read: if signedIn() && isOwner(uid);
      allow write: if false;
    }

    // ─── userIndex/{identifier} — identifier → uid mapping ──────────────
    // Only the person who owns that identifier may look it up (used by the
    // backend for restore; the app keys directly by UID).
    match /userIndex/{identifier} {
      allow read: if signedIn() && (
        request.auth.token.phone_number == identifier ||
        request.auth.token.email == identifier);
      allow write: if false; // backend Admin SDK only
    }

    // ─── meals/{mealId} — one doc per meal, `uid` field = owner ─────────
    // The `uid` field must equal the caller's uid on CREATE **and** UPDATE:
    // checking only the stored copy would let a user move their meal to
    // another account (or claim someone else's meal) with an update.
    //
    // `validMeal()` bounds the payload as well. Without it a client could write
    // a 10 MB document, arbitrary fields, or a negative/absurd calorie value
    // that every restore path then has to survive. Optional fields are only
    // type-checked when present, so old/backfilled docs can still be updated.
    function validMeal() {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 80
        && d.calories is int
        && d.calories >= 0
        && d.calories <= 10000
        && d.date is string
        && d.date.size() <= 40
        && d.size() <= 20
        && (!('serving' in d) || (d.serving is string && d.serving.size() <= 200))
        && (!('category' in d) || (d.category is string && d.category.size() <= 40))
        && (!('protein' in d) || (d.protein is number && d.protein >= 0 && d.protein <= 1000))
        && (!('carbs' in d) || (d.carbs is number && d.carbs >= 0 && d.carbs <= 1000))
        && (!('fats' in d) || (d.fats is number && d.fats >= 0 && d.fats <= 1000))
        && (!('fiber' in d) || (d.fiber is number && d.fiber >= 0 && d.fiber <= 1000));
    }

    match /meals/{mealId} {
      allow create: if signedIn() && validMeal();
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && validMeal();
      allow read, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ─── habitData/{uid} — one doc per user: habits[], waterLog, waterGoal ─
    match /habitData/{uid} {
      allow read: if signedIn() && isOwner(uid);
      allow create, update: if signedIn() && isOwner(uid)
        && request.resource.data.habits is list
        && (request.resource.data.habits.size() <= 3 || hasPro(uid));
      allow delete: if signedIn() && isOwner(uid);
    }

    // ─── dietProfiles/{uid} — diet profile (goal, activity, measurements) ─
    match /dietProfiles/{uid} {
      allow read, write: if signedIn() && isOwner(uid);
    }

    // ─── recentFoods/{uid} — recently logged/searched foods ────────────
    match /recentFoods/{uid} {
      allow read, write: if signedIn() && isOwner(uid);
    }

    // ─── userPreferences/{uid} — theme, display name, etc. ─────────────
    match /userPreferences/{uid} {
      allow read, write: if signedIn() && isOwner(uid);
    }

    // ─── deletedAccounts/{identifier} — deletion tombstones ────────────
    // Written ONLY by the backend via the Admin SDK (rules bypass) when an
    // account deletes itself, and NEVER wiped. It remembers the identifier
    // and its consumed trial so delete -> re-register can never re-claim
    // the free trial. Clients must never read or write it.
    match /deletedAccounts/{identifier} {
      allow read, write: if false;
    }

    // ─── subscriptions/{subId} — Razorpay subscription lifecycle ────────
    // Written ONLY by the backend webhook via Admin SDK. Read = owner only.
    match /subscriptions/{subId} {
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─── payments/{id} — payment records ────────────────────────────────
    // Written ONLY by /payment/verify + webhook via Admin SDK.
    match /payments/{id} {
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─── referrals/{code} — referral-code index ─────────────────────────
    // Reward grants run server-side (Admin SDK, which bypasses these rules).
    // A client may create and read only ITS OWN code: the previous
    // `allow read: if signedIn()` let any signed-in account read every other
    // user's referral document (uid, code, reward state). Code redemption is
    // a backend operation, so nothing legitimate needs cross-user reads.
    match /referrals/{code} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.size() <= 10;
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
