<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (v31) dark-mode launch theme.
     The day variant lives in res/values-v31. Without this night twin, a
     dark-mode launch on Android 12+ resolved LaunchTheme from values-v31,
     whose parent is Theme.Light — pinning the whole launch (system splash,
     window background before Flutter paints) to the dark colour set instead. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/window_background</item>
        <!-- Edge-to-edge is enabled via EdgeToEdge.enable() in MainActivity. -->
        <!-- Do NOT add android:windowOptOutEdgeToEdgeEnforcement here. -->
    </style>
</resources>
